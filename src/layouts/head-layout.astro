---
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
const { title } = Astro.props;
---

<!-- Head Metadata -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/applysavedtheme.js" is:inline></script>
    <script type="module" src="/scripts/js/main.js"></script>
  </head>

  <!-- Body element insertion -->

  <body>
    <Topbar />
    <div class="layout">
      <nav class="sidebar">
        <input type="text" id="searchBar" placeholder="Search errors..." />
        <h2>List of Errors</h2>
        <Sidebar />
      </nav>
      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>
